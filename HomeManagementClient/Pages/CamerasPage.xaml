<ContentPage x:Class="HomeManagementClient.Pages.CamerasPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="CamerasViewModel"
             Shell.NavBarIsVisible="False"
             Title="Cameras">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12" IsVisible="{Binding IsConfigured}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Cameras" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="Tap a camera for live view" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <ScrollView>
                    <StaticItemsView ItemsSource="{Binding Cameras}"
                                     Version="{Binding LoadVersion}"
                                     EmptyText="No cameras"
                                     MinItemWidth="360">
                        <StaticItemsView.ItemTemplate>
                            <DataTemplate x:DataType="CameraItemViewModel">
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCameraCommand, Source={RelativeSource AncestorType={x:Type CamerasViewModel}}, x:DataType=CamerasViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid HeightRequest="220" BackgroundColor="Black">
                                            <Image Source="{Binding Snapshot}" Aspect="AspectFit" />
                                            <Label Text="{Binding SnapshotError}" TextColor="White" Margin="16"
                                                   HorizontalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{SnapshotError != null}" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="16,10">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </StaticItemsView.ItemTemplate>
                    </StaticItemsView>
                </ScrollView>
            </RefreshView>
        </Grid>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
