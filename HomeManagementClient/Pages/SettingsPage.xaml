<ContentPage x:Class="HomeManagementClient.Pages.SettingsPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Settings">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="640">
            <Label Text="Settings" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Hub" Style="{StaticResource CardTitle}" />

                    <Label Text="Address" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding HubUrl}"
                           Placeholder="http://home-management.local"
                           Keyboard="Url"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />

                    <Label Text="Key" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding ApiKey}"
                           Placeholder="The key you sign in to the hub with"
                           IsPassword="True"
                           ReturnCommand="{Binding SaveCommand}" />

                    <Button Text="Save and connect" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

                    <Label Text="{Binding ConnectionStatus}" IsVisible="{Binding HasConnectionStatus}" Style="{StaticResource ErrorText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource StatusOnline}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
