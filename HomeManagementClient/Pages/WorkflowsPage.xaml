<ContentPage x:Class="HomeManagementClient.Pages.WorkflowsPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="WorkflowsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Workflows">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12" IsVisible="{Binding IsConfigured}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Workflows" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding Workflows}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Grid>
                            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="No workflows" Style="{StaticResource Caption}" HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="16" Color="Transparent" BackgroundColor="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="WorkflowItemViewModel">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding IsEnabled}"
                                            IsEnabled="{Binding IsUpdating, Converter={StaticResource InvertedBoolConverter}}"
                                            VerticalOptions="Center" />

                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                           IsVisible="{Binding Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />

                                    <Label Grid.Row="2" Grid.ColumnSpan="2" FontSize="13">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="When " Style="{StaticResource Caption}" />
                                                <Span Text="{Binding Trigger}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label Grid.Row="3" Text="{Binding Details}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    <Button Grid.Row="3" Grid.Column="1"
                                            Text="Run now"
                                            Command="{Binding RunCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <NotConfiguredView IsVisible="{Binding IsConfigured, Converter={StaticResource InvertedBoolConverter}}" />
    </Grid>
</ContentPage>
