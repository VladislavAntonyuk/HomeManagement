<ContentPage x:Class="HomeManagementClient.Pages.WorkflowsPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="WorkflowsViewModel"
             Shell.NavBarIsVisible="False"
             Title="Workflows">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <PlatformTemplateSelector x:Key="WorkflowTemplateSelector">
            <PlatformTemplateSelector.Default>
                <DataTemplate x:DataType="WorkflowItemViewModel">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsEnabled}"
                                    IsEnabled="{!IsUpdating}"
                                    VerticalOptions="Center" />

                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                   IsVisible="{Description != null}" />

                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                <Label Text="When" Style="{StaticResource Caption}" FontSize="13" />
                                <Label Grid.Column="1" Text="{Binding Trigger}" FontSize="13" />
                            </Grid>

                            <Label Grid.Row="3" Text="{Binding Details}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            <Button Grid.Row="3" Grid.Column="1"
                                    Text="Run now"
                                    Command="{Binding RunCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </PlatformTemplateSelector.Default>

            <PlatformTemplateSelector.Linux>
                <DataTemplate x:DataType="WorkflowItemViewModel">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                <Label Grid.Column="1" Text="{Binding EnabledText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding TriggerText}" FontSize="13" />
                            <Label Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="{Binding ToggleText}" Command="{Binding ToggleEnabledCommand}" />
                                <Button Grid.Column="1" Text="Run now" Command="{Binding RunCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </PlatformTemplateSelector.Linux>
        </PlatformTemplateSelector>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12" IsVisible="{Binding IsConfigured}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Workflows" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <Label Grid.Row="2" Text="{Binding Notifier.LastMessage}" Style="{StaticResource Caption}" HeightRequest="20" IsVisible="{x:Static UserNotifier.UsesInlineResults}" />

            <RefreshView Grid.Row="3" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView x:Name="ItemsList" ItemsSource="{Binding Workflows}"
                            ItemTemplate="{StaticResource WorkflowTemplateSelector}"
                            EmptyView="{IsLoading ? 'Loading...' : 'No workflows'}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="16" Color="Transparent" BackgroundColor="Transparent" />
                    </CollectionView.Footer>

                </CollectionView>
            </RefreshView>
        </Grid>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
