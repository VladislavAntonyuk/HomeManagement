<ContentPage x:Class="HomeManagementClient.Pages.DevicesPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="DevicesViewModel"
             Shell.NavBarIsVisible="False"
             Title="Devices">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <PlatformTemplateSelector x:Key="PlatformTemplateSelector">
            <PlatformTemplateSelector.Default>
                <DataTemplate x:DataType="DeviceItemViewModel">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding DeviceId}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource Chip}"
                                        BackgroundColor="{Binding Status, Converter={StaticResource PresenceStatusToColorConverter}}">
                                    <Label Text="{Binding StatusText}" Style="{StaticResource ChipText}" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding Description}" IsVisible="{Description != null}" />

                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding LastSeen}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Address}" Style="{StaticResource Caption}"
                                       IsVisible="{Address != null}" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Metrics}" Spacing="16"
                                                   IsVisible="{Metrics.Count > 0}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="DeviceMetricViewModel">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="{Binding Label}" Style="{StaticResource Caption}" />
                                            <Label Text="{Binding DisplayValue}" FontSize="13" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActionRows}" Spacing="8"
                                                 IsVisible="{Actions.Count > 0}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="DeviceActionRow">
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" BindableLayout.ItemsSource="{Binding Actions}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="DeviceActionItemViewModel">
                                                    <Button Grid.Column="{Binding Column}"
                                                            Text="{Binding Name}"
                                                            Command="{Binding RunCommand}"
                                                            LineBreakMode="WordWrap"
                                                            Style="{StaticResource SecondaryButton}">
                                                        <Button.Triggers>
                                                            <DataTrigger TargetType="Button" Binding="{Binding IsReadOnly}" Value="False">
                                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                                            </DataTrigger>
                                                        </Button.Triggers>
                                                    </Button>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </PlatformTemplateSelector.Default>

            <PlatformTemplateSelector.Linux>
                <DataTemplate x:DataType="DeviceItemViewModel">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding DeviceId}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Style="{StaticResource Chip}"
                                        BackgroundColor="{Binding Status, Converter={StaticResource PresenceStatusToColorConverter}}">
                                    <Label Text="{Binding StatusText}" Style="{StaticResource ChipText}" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding MetricsText}" FontSize="13" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Picker ItemsSource="{Binding Actions}"
                                        SelectedItem="{Binding SelectedAction}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=DeviceActionItemViewModel}" />
                                <Button Grid.Column="1" Text="Run" Command="{Binding RunSelectedActionCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </PlatformTemplateSelector.Linux>
        </PlatformTemplateSelector>
    </ContentPage.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12" IsVisible="{Binding IsConfigured}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Devices" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <SearchBar Grid.Row="1" Placeholder="Search devices" Text="{Binding SearchText}" />

            <Border Grid.Row="2" Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <Label Grid.Row="3" Text="{Binding Notifier.LastMessage}" Style="{StaticResource Caption}" HeightRequest="20" IsVisible="{x:Static UserNotifier.UsesInlineResults}" />

            <RefreshView Grid.Row="4" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView x:Name="ItemsList" ItemsSource="{Binding Devices}"
                            ItemTemplate="{StaticResource PlatformTemplateSelector}"
                            EmptyView="{IsLoading ? 'Loading...' : 'No devices'}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="16" Color="Transparent" BackgroundColor="Transparent" />
                    </CollectionView.Footer>

                </CollectionView>
            </RefreshView>
        </Grid>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
