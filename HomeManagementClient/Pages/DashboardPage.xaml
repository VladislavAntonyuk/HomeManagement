<ContentPage x:Class="HomeManagementClient.Pages.DashboardPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Dashboard">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <ContentPage.Resources>
        <DashboardTileTemplateSelector x:Key="TileTemplateSelector">
            <DashboardTileTemplateSelector.Devices>
                <DataTemplate x:DataType="DashboardTile">
                    <ContentView>
                        <Border Style="{StaticResource Card}"
                                BindingContext="{Binding Dashboard, x:DataType=DashboardTile}"
                                x:DataType="DashboardViewModel">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//devices" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Devices" Style="{StaticResource Caption}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Dashboard.OnlineDevices}" Style="{StaticResource BigValue}" TextColor="{StaticResource StatusOnline}" />
                                    <Label Text="{$'of {Dashboard?.TotalDevices} online'}" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                                <ProgressBar Progress="{Binding OnlineShare}" ProgressColor="{StaticResource StatusOnline}" />
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{$'{Dashboard?.OfflineDevices} offline'}" Style="{StaticResource Caption}" TextColor="{StaticResource StatusOffline}" />
                                    <Label Text="{$'{Dashboard?.NotRespondingDevices} not responding'}" Style="{StaticResource Caption}" TextColor="{StaticResource StatusWarning}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </DashboardTileTemplateSelector.Devices>

            <DashboardTileTemplateSelector.Workflows>
                <DataTemplate x:DataType="DashboardTile">
                    <ContentView>
                        <Border Style="{StaticResource Card}"
                                BindingContext="{Binding Dashboard, x:DataType=DashboardTile}"
                                x:DataType="DashboardViewModel">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//workflows" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Workflows" Style="{StaticResource Caption}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Dashboard.EnabledWorkflows}" Style="{StaticResource BigValue}" />
                                    <Label Text="{$'of {Dashboard?.TotalWorkflows} enabled'}" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                                <Label Text="{$'Last run {LastWorkflowRun}'}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </DashboardTileTemplateSelector.Workflows>

            <DashboardTileTemplateSelector.Hub>
                <DataTemplate x:DataType="DashboardTile">
                    <ContentView>
                        <Border Style="{StaticResource Card}"
                                BindingContext="{Binding Dashboard, x:DataType=DashboardTile}"
                                x:DataType="DashboardViewModel">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Hub" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Dashboard.Hub.MachineName}" Style="{StaticResource CardTitle}" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                    <Label Text="Address" Style="{StaticResource Caption}" />
                                    <Label Grid.Column="1" Text="{Binding Dashboard.Hub.LocalIp, TargetNullValue='-'}" />
                                    <Label Grid.Row="1" Text="Uptime" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding HubUptime}" />
                                    <Label Grid.Row="2" Text="Temperature" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding HubTemperature}" />
                                    <Label Grid.Row="3" Text="System" Style="{StaticResource Caption}" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Dashboard.Hub.OperatingSystem}" LineBreakMode="TailTruncation" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </DashboardTileTemplateSelector.Hub>
        </DashboardTileTemplateSelector>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     IsVisible="{Binding IsConfigured}">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="16,16,16,0">
                    <Label Text="Home" Style="{StaticResource PageTitle}" />

                    <Border Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                        <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Away mode" Style="{StaticResource CardTitle}" />
                                <Label Text="Cameras alert when they see a person." Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding AwayModeEnabled}"
                                    IsEnabled="{!IsUpdatingAwayMode}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <StaticItemsView ItemsSource="{Binding Tiles}"
                                     Version="{Binding LoadVersion}"
                                     ItemTemplate="{StaticResource TileTemplateSelector}"
                                     MinItemWidth="300"
                                     BottomPadding="0" />

                    <HorizontalStackLayout Spacing="8" Padding="0,0,0,16">
                        <Button Text="Devices" Command="{Binding GoToCommand}" CommandParameter="//devices" Style="{StaticResource SecondaryButton}" />
                        <Button Text="Workflows" Command="{Binding GoToCommand}" CommandParameter="//workflows" Style="{StaticResource SecondaryButton}" />
                        <Button Text="Cameras" Command="{Binding GoToCommand}" CommandParameter="//cameras" Style="{StaticResource SecondaryButton}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
