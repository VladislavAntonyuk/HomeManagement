<ContentPage x:Class="HomeManagement.Client.Pages.SettingsPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="SettingsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static AppResources.Settings}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="640">
            <Label Text="{x:Static AppResources.Settings}" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static AppResources.Hub}" Style="{StaticResource CardTitle}" />

                    <Label Text="{x:Static AppResources.Address}" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding HubUrl}"
                           Placeholder="http://home-management.local"
                           Keyboard="Url"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />

                    <Label Text="{x:Static AppResources.Key}" Style="{StaticResource Caption}" />
                    <Entry Text="{Binding ApiKey}"
                           Placeholder="{x:Static AppResources.KeyPlaceholder}"
                           IsPassword="True"
                           ReturnCommand="{Binding SaveCommand}" />

                    <Button Text="{x:Static AppResources.SaveAndConnect}" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

                    <Label Text="{Binding ConnectionStatus}" IsVisible="{ConnectionStatus != null}" Style="{StaticResource ErrorText}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource StatusOnline}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static AppResources.Language}" Style="{StaticResource CardTitle}" />
                    <Picker ItemsSource="{Binding Languages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            ItemDisplayBinding="{Binding Name, x:DataType=LanguageOption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding AppVersion}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
