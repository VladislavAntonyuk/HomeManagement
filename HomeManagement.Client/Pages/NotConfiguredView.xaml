<ContentView x:Class="HomeManagement.Client.Pages.NotConfiguredView"
             x:DataType="RefreshableViewModel">
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="420">
        <Label Text="{x:Static AppResources.ConnectTitle}" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center" />
        <Label Text="{x:Static AppResources.ConnectDescription}"
               Style="{StaticResource Caption}"
               FontSize="14"
               HorizontalTextAlignment="Center" />
        <Button Text="{x:Static AppResources.OpenSettings}" Command="{Binding OpenSettingsCommand}" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentView>
