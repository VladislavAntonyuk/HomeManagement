<ContentPage x:Class="HomeManagement.Client.Pages.DashboardPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="DashboardViewModel"
             Shell.NavBarIsVisible="False"
             Title="Dashboard">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <ScrollView IsVisible="{Binding IsConfigured}">
            <VerticalStackLayout Spacing="16" Padding="16,16,16,0">
                <Label Text="Home" Style="{StaticResource PageTitle}" />

                <Border Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                </Border>

                <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="WidthStates">
                            <VisualState x:Name="Narrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ColumnDefinitions" Value="*" />
                                    <Setter Property="RowDefinitions" Value="Auto,Auto,Auto" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="HubTile" Property="Grid.Row" Value="2" />
                                    <Setter TargetName="HubTile" Property="Grid.Column" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Medium">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="700" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ColumnDefinitions" Value="*,*" />
                                    <Setter Property="RowDefinitions" Value="Auto,Auto" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="HubTile" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="HubTile" Property="Grid.Column" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1000" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Property="ColumnDefinitions" Value="*,*,*" />
                                    <Setter Property="RowDefinitions" Value="Auto" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="WorkflowsTile" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="HubTile" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="HubTile" Property="Grid.Column" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//devices" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Devices" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Dashboard.OnlineDevices}" Style="{StaticResource BigValue}" TextColor="{StaticResource StatusOnline}" />
                                <Label Text="{$'of {Dashboard?.TotalDevices} online'}" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                            <ProgressBar Progress="{Binding OnlineShare}" ProgressColor="{StaticResource StatusOnline}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{$'{Dashboard?.OfflineDevices} offline'}" Style="{StaticResource Caption}" TextColor="{StaticResource StatusOffline}" />
                                <Label Text="{$'{Dashboard?.NotRespondingDevices} not responding'}" Style="{StaticResource Caption}" TextColor="{StaticResource StatusWarning}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="WorkflowsTile" Grid.Row="1" Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToCommand}" CommandParameter="//workflows" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Workflows" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Dashboard.EnabledWorkflows}" Style="{StaticResource BigValue}" />
                                <Label Text="{$'of {Dashboard?.TotalWorkflows} enabled'}" VerticalOptions="End" Margin="0,0,0,6" />
                            </HorizontalStackLayout>
                            <Label Text="{$'Last run {LastWorkflowRun}'}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="HubTile" Grid.Row="2" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Hub" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Dashboard.Hub.MachineName}" Style="{StaticResource CardTitle}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                <Label Text="Address" Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="{Dashboard?.Hub.LocalIp ?? '-'}" />
                                <Label Grid.Row="1" Text="Uptime" Style="{StaticResource Caption}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding HubUptime}" />
                                <Label Grid.Row="2" Text="Temperature" Style="{StaticResource Caption}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Dashboard?.Hub.TemperatureCelsius == null ? '-' : $'{Dashboard!.Hub.TemperatureCelsius:0.#} °C'}" />
                                <Label Grid.Row="3" Text="System" Style="{StaticResource Caption}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding Dashboard.Hub.OperatingSystem}" LineBreakMode="TailTruncation" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <FlexLayout Wrap="Wrap" AlignItems="Start" AlignContent="Start" Padding="0,0,0,8">
                    <Button Text="Devices" Command="{Binding GoToCommand}" CommandParameter="//devices" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                    <Button Text="Workflows" Command="{Binding GoToCommand}" CommandParameter="//workflows" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                    <Button Text="Cameras" Command="{Binding GoToCommand}" CommandParameter="//cameras" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
