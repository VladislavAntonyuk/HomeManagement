<ContentPage x:Class="HomeManagement.Client.Pages.CamerasPage"
             x:Name="Page"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="CamerasViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static AppResources.Cameras}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Appearing" Command="{Binding AppearingCommand}" />
        <toolkit:EventToCommandBehavior BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType=ContentPage}" EventName="Disappearing" Command="{Binding DisappearingCommand}" />
    </ContentPage.Behaviors>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="12" IsVisible="{Binding IsConfigured}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static AppResources.Cameras}" Style="{StaticResource PageTitle}" />
                <Label Grid.Column="1" Text="{x:Static AppResources.CamerasHint}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" IsVisible="{ErrorMessage != null}">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
            </Border>

            <RefreshView Grid.Row="2" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
                <CollectionView ItemsSource="{Binding Cameras}" SelectionMode="None">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="WidthStates">
                            <VisualState x:Name="Narrow">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter TargetName="CamerasLayout" Property="GridItemsLayout.Span" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Medium">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="800" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter TargetName="CamerasLayout" Property="GridItemsLayout.Span" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Wide">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1200" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter TargetName="CamerasLayout" Property="GridItemsLayout.Span" Value="3" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="CamerasLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Grid>
                            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Label Text="{x:Static AppResources.NoCameras}" Style="{StaticResource Caption}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{!IsLoading}" />
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <BoxView HeightRequest="16" Color="Transparent" BackgroundColor="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="CameraItemViewModel">
                            <Border Style="{StaticResource Card}" Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCameraCommand, Source={RelativeSource AncestorType={x:Type CamerasViewModel}}, x:DataType=CamerasViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto">
                                    <Grid HeightRequest="220" BackgroundColor="Black">
                                        <Image Source="{Binding Snapshot}" Aspect="AspectFit" />
                                        <Label Text="{Binding SnapshotError}" TextColor="White" Margin="16"
                                               HorizontalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{SnapshotError != null}" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="16,10">
                                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding UpdatedText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <NotConfiguredView IsVisible="{!IsConfigured}" />
    </Grid>
</ContentPage>
