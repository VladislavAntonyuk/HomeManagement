{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "frigate-service": {
      "http": [ "http://127.0.0.1:5000" ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "frigate-subdomain-route": {
        "ClusterId": "frigate-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Hosts": [ "cameras.home-management.local", "cameras.home-management.local:*" ],
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "frigate-cluster": {
        "Destinations": {
          "frigate-destination": {
            "Address": "https+http://frigate-service"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        }
      }
    }
  },
  "Auth": {
    "Key": "key"
  },
  "TelegramSettings": {
    "ChatId": 1,
    "Token": "token"
  },
  "EmailSettings": {
    "ApiKey": "",
    "ApiSecret": "",
    "FromEmail": "",
    "To": []
  },
  "Router": {
    "IpAddress": "",
    "Username": "",
    "Password": ""
  },
  "InternetWatchdog": {
    "Enabled": false,
    "PingAddress": "1.1.1.1",
    "PingTimeoutMs": 3000,
    "CheckIntervalSeconds": 60,
    "ConsecutiveFailuresBeforeReboot": 3,
    "RebootCooldownMinutes": 15
  },
  "WorkflowAutomation": {
    "Enabled": true,
    "CheckIntervalSeconds": 30,
    "Latitude": 0,
    "Longitude": 0,
    "TimeZoneId": "Europe/Kyiv"
  }
}
