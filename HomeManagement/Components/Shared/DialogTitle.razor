<div class="dialog-title">
    <IconBadge Icon="@Icon" Accent="@Accent" />
    <div class="dialog-title-text">
        <MudText Typo="Typo.h6" Class="dialog-title-heading">@Title</MudText>
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtitle</MudText>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Icon { get; set; }

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public Color Accent { get; set; } = Color.Primary;
}
