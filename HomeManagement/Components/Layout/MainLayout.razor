@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<MudRTLProvider RightToLeft="_rightToLeft">
    <MudThemeProvider @bind-IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider CloseButton="true"
                       CloseOnEscapeKey="true"
                       BackdropClick="false"
                       Position="DialogPosition.Center" />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudLink Href="/">
                    <img src="icon.svg" alt="@Strings.Layout_AppName" class="mud-icon-root mud-icon-size-large" />
                </MudLink>
            </MudHidden>
            <AuthorizeView>
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="@Strings.Layout_Menu" OnClick="DrawerToggle" />
                </MudHidden>
            </AuthorizeView>
            <MudHidden Breakpoint="Breakpoint.Xs">
                <MudLink Href="/" Typo="Typo.h6" Class="ml-4" Color="Color.Inherit">@Strings.Layout_AppName</MudLink>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
                <MudLink Href="/" Typo="Typo.subtitle2" Color="Color.Inherit">@Strings.Layout_AppName</MudLink>
            </MudHidden>
            <MudSpacer />
            <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     AriaLabel="@Strings.Layout_Language" title="@Strings.Layout_Language">
                @foreach (var culture in AppCultures.All)
                {
                    var isCurrent = culture == AppCultures.Current;
                    <MudMenuItem @key="culture.Culture.Name" OnClick="() => SetCulture(culture)"
                                 Icon="@(isCurrent ? Icons.Material.Filled.Check : null)" lang="@culture.Culture.Name">
                        @culture.NativeName
                    </MudMenuItem>
                }
            </MudMenu>
            <MudToggleIconButton @bind-Toggled="_rightToLeft"
                                 Icon="@Icons.Material.Filled.FormatTextdirectionRToL"
                                 ToggledIcon="@Icons.Material.Filled.FormatTextdirectionRToL"
                                 Color="Color.Inherit"
                                 aria-label="@Strings.Layout_RightToLeft" title="@Strings.Layout_RightToLeft" />
        </MudAppBar>

        @* Signed-out visitors only see the sign-in page, which needs no navigation. *@
        <AuthorizeView>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Class="app-drawer">
                <div class="app-drawer-content">
                    <NavMenu />
                </div>
            </MudDrawer>
        </AuthorizeView>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.False">
                <ErrorBoundary @ref="_errorBoundary" MaximumErrorCount="5">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <MudAlert Severity="Severity.Error" Class="mt-4">
                            <MudText Typo="Typo.h6">@Strings.Common_ErrorOccurred</MudText>
                            <MudText Typo="Typo.body2">@exception.Message</MudText>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </MudContainer>
            <MudScrollToTop Style="z-index: 1200">
                <MudFab StartIcon="@Icons.Material.Filled.ArrowUpward" Color="Color.Primary" />
            </MudScrollToTop>
        </MudMainContent>
    </MudLayout>
</MudRTLProvider>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _rightToLeft;
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _errorBoundary?.Recover();

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    // The language is read once per connection, so the page reloads to show the new one.
    private void SetCulture(AppCulture culture)
    {
        var page = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo(
            $"culture/set?culture={Uri.EscapeDataString(culture.Culture.Name)}&redirectUri={Uri.EscapeDataString(page)}",
            forceLoad: true);
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    @Strings.Layout_UnhandledError
    <a href="." class="reload">@Strings.Layout_Reload</a>
    <span class="dismiss" title="@Strings.Layout_Dismiss">🗙</span>
</div>
