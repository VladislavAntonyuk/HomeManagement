<MudPaper Class="pa-4" Elevation="1" Style="min-width:500px;max-width:800px;">
    <MudStack Spacing="2">
        @if (_loading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <MudText>Scanning the local network...</MudText>
            </MudStack>
        }
        else
        {
            <MudTable T="SelectableDevice" Items="_devices" Dense="true" Hover="true" Bordered="true" Class="my-2">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>IP</MudTh>
                    <MudTh>Name</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudCheckBox T="bool" @bind-Value="context.Selected" Disabled="context.IsExisting" /></MudTd>
                    <MudTd>@context.Device.Address</MudTd>
                    <MudTd>
                        @context.Device.Name
                        @if (context.IsExisting)
                        {
                            <MudChip T="string" Size="Size.Small" Class="ms-2">Already added</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No devices found</MudText>
                </NoRecordsContent>
            </MudTable>
        }
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_devices.Any(d => d.Selected))" OnClick="Save">Add Selected</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>
