@inherits ComponentBase

<MudPaper Class="pa-4" Elevation="1">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" />
        <MudTextField @bind-Value="Model.Description" Label="Description" Lines="5" Required="false" />
        <MudText Color="Color.Secondary" Typo="Typo.caption">Actions are reported by the device.</MudText>

        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>
