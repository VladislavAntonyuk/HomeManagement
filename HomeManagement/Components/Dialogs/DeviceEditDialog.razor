<MudDialog>
    <TitleContent>
        <DialogTitle Icon="@Icons.Material.Rounded.Memory" Title="@DialogReference.Title"
                     Subtitle="@Strings.DeviceEdit_Subtitle" />
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <div class="device-form">
                <MudTextField @bind-Value="Model.Name" Label="@Strings.Common_Name" Required="true" RequiredError="@Strings.Common_EnterName"
                              Variant="Variant.Outlined" Immediate="true" />
                <MudTextField @bind-Value="Model.Description" Label="@Strings.Common_Description" Lines="3" Sizing="InputSizing.Auto" MaxLines="8"
                              Variant="Variant.Outlined" HelperText="@Strings.DeviceEdit_DescriptionHelp" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Strings.Common_Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Rounded.Check" OnClick="Save">@Strings.Common_Save</MudButton>
    </DialogActions>
</MudDialog>
