@using HomeManagement.Application.Workflows
@using HomeManagement.Infrastructure.Database.Entities

<MudPaper Class="pa-4" Elevation="1">
    <MudForm @ref="_form">
        <MudTextField @bind-Value="Model.Name" Label="Name" Required="true" />
        <MudTextField @bind-Value="Model.Description" Label="Description" Lines="3" />
        <MudSwitch @bind-Value="Model.IsEnabled" Color="Color.Primary" Label="Enabled" />

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle1">Triggers</MudText>
        @if (Model.Triggers.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary my-2">No triggers: the workflow runs only when you run it. Add a trigger to run it automatically.</MudText>
        }
        else
        {
            @if (Model.Triggers.Count > 1)
            {
                <MudSelect T="WorkflowConditionOperator" @bind-Value="Model.ConditionOperator" Label="Combine triggers">
                    <MudSelectItem T="WorkflowConditionOperator" Value="WorkflowConditionOperator.And">AND</MudSelectItem>
                    <MudSelectItem T="WorkflowConditionOperator" Value="WorkflowConditionOperator.Or">OR</MudSelectItem>
                </MudSelect>
            }

            <MudSwitch @bind-Value="Model.RepeatWhileMatched" Color="Color.Primary" Label="Repeat on every check while the triggers match (e.g. alerts)" />
        }

        @foreach (var (index, trigger) in Model.Triggers.Index())
        {
            <MudPaper @key="trigger" Class="pa-2 my-2" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Style="font-size: 0.875rem;">@(index + 1)</MudAvatar>
                        <MudSelect T="TriggerKind" Value="@trigger.Kind" ValueChanged="trigger.SetKind" Label="Trigger" Class="action-field">
                            @foreach (var kind in Enum.GetValues<TriggerKind>())
                            {
                                <MudSelectItem T="TriggerKind" Value="@kind">@kind</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSpacer />
                        <MudTooltip Text="Move up">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" aria-label="Move trigger up" Disabled="@(index == 0)" OnClick="() => Move(Model.Triggers, trigger, -1)" />
                        </MudTooltip>
                        <MudTooltip Text="Move down">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" aria-label="Move trigger down" Disabled="@(index == Model.Triggers.Count - 1)" OnClick="() => Move(Model.Triggers, trigger, 1)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete trigger" Color="Color.Error" OnClick='() => RemoveAsync(Model.Triggers, trigger, "trigger")' />
                        </MudTooltip>
                    </MudStack>

                    @switch (trigger.Kind)
                    {
                        case TriggerKind.Date:
                            <MudSelect T="WorkflowComparisonOperator" @bind-Value="trigger.Operator" Label="Operator">
                                @foreach (var op in WorkflowFormatter.DateOperators)
                                {
                                    <MudSelectItem T="WorkflowComparisonOperator" Value="@op">@WorkflowFormatter.FormatOperator(OperatorSubject.Date, op)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudDatePicker Label="@(trigger.IsRange ? "From" : "Date")" Date="@ToDateTime(trigger.Date)" DateChanged="value => trigger.Date = ToDateOnly(value)" Required="true" />
                            @if (trigger.IsRange)
                            {
                                <MudDatePicker Label="To" Date="@ToDateTime(trigger.DateTo)" DateChanged="value => trigger.DateTo = ToDateOnly(value)" Required="true" />
                            }

                            break;

                        case TriggerKind.Time:
                            <MudSelect T="WorkflowComparisonOperator" @bind-Value="trigger.Operator" Label="Operator">
                                @foreach (var op in WorkflowFormatter.TimeOperators)
                                {
                                    <MudSelectItem T="WorkflowComparisonOperator" Value="@op">@WorkflowFormatter.FormatOperator(OperatorSubject.Time, op)</MudSelectItem>
                                }
                            </MudSelect>
                            @if (trigger.Operator is WorkflowComparisonOperator.Equal)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Matches once per day, within a few minutes after the time is reached.</MudText>
                            }

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudSelect T="WorkflowTimeReference" @bind-Value="trigger.FromReference" Label="@(trigger.IsRange ? "From" : "Time")" Class="action-field">
                                    @foreach (var reference in Enum.GetValues<WorkflowTimeReference>())
                                    {
                                        <MudSelectItem T="WorkflowTimeReference" Value="@reference">@reference</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (trigger.FromReference is WorkflowTimeReference.Fixed)
                                {
                                    <MudTimePicker Label="Fixed time" Time="@trigger.FromTime?.ToTimeSpan()" TimeChanged="value => trigger.FromTime = ToTimeOnly(value)" Required="true" Class="action-field" />
                                }
                                else
                                {
                                    <MudNumericField T="int" @bind-Value="trigger.FromOffsetMinutes" Label="Offset (minutes)" HelperText="Negative for before" Class="action-field" />
                                }
                            </MudStack>

                            @if (trigger.IsRange)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudSelect T="WorkflowTimeReference" @bind-Value="trigger.ToReference" Label="To" Class="action-field">
                                        @foreach (var reference in Enum.GetValues<WorkflowTimeReference>())
                                        {
                                            <MudSelectItem T="WorkflowTimeReference" Value="@reference">@reference</MudSelectItem>
                                        }
                                    </MudSelect>
                                    @if (trigger.ToReference is WorkflowTimeReference.Fixed)
                                    {
                                        <MudTimePicker Label="Fixed time" Time="@trigger.ToTime?.ToTimeSpan()" TimeChanged="value => trigger.ToTime = ToTimeOnly(value)" Required="true" Class="action-field" />
                                    }
                                    else
                                    {
                                        <MudNumericField T="int" @bind-Value="trigger.ToOffsetMinutes" Label="Offset (minutes)" HelperText="Negative for before" Class="action-field" />
                                    }
                                </MudStack>
                            }

                            break;

                        case TriggerKind.DeviceStatus:
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudSelect T="int?" @bind-Value="trigger.DeviceId" Label="Device" Required="true" ToStringFunc="DeviceName" Class="action-field">
                                    @foreach (var device in Devices)
                                    {
                                        <MudSelectItem T="int?" Value="@device.Id">@device.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="DeviceStatus" @bind-Value="trigger.ExpectedStatus" Label="Goes" Class="action-field">
                                    @foreach (var status in Enum.GetValues<DeviceStatus>())
                                    {
                                        <MudSelectItem T="DeviceStatus" Value="@status">@status</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Runs once each time the device changes to this status. Use OR with the other status to be told about both.</MudText>
                            break;

                        case TriggerKind.DeviceResult:
                            <MudSelect T="int?" Value="@trigger.DeviceId" ValueChanged="value => OnTriggerDeviceChanged(trigger, value)" Label="Device" Required="true" ToStringFunc="DeviceName">
                                @foreach (var device in Devices)
                                {
                                    <MudSelectItem T="int?" Value="@device.Id">@device.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="int?" Value="@trigger.ActionId" ValueChanged="value => OnTriggerActionChanged(trigger, value)" Label="Action" Required="true" Disabled="@(trigger.DeviceId is null)" ToStringFunc="ActionName">
                                @foreach (var action in ActionsOf(trigger.DeviceId))
                                {
                                    <MudSelectItem T="int?" Value="@action.Id">@action.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => PreviewAsync(trigger)" Disabled="@(trigger.ActionId is null || trigger.IsPreviewLoading)">Preview response</MudButton>
                                @if (trigger.Preview?.Error is { } previewError)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error">@previewError</MudText>
                                }
                            </MudStack>

                            @if (!string.IsNullOrWhiteSpace(trigger.Preview?.RawResponse))
                            {
                                <MudTextField Value="@trigger.Preview.RawResponse" Label="Response" ReadOnly="true" Lines="3" />
                            }

                            <MudSelect T="string" Value="@trigger.PropertyPath" ValueChanged="trigger.SetProperty" Label="JSON property" Required="true" Disabled="@(trigger.Properties.Count == 0)">
                                @foreach (var property in trigger.Properties)
                                {
                                    <MudSelectItem T="string" Value="@property.Path">@($"{property.Path} ({property.ValueType})")</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="WorkflowComparisonOperator" @bind-Value="trigger.Operator" Label="Operator">
                                @foreach (var op in WorkflowFormatter.GetValueOperators(trigger.ValueType ?? WorkflowTriggerValueType.Text))
                                {
                                    <MudSelectItem T="WorkflowComparisonOperator" Value="@op">@WorkflowFormatter.FormatOperator(OperatorSubject.Value, op)</MudSelectItem>
                                }
                            </MudSelect>

                            @switch (trigger.ValueType)
                            {
                                case WorkflowTriggerValueType.Boolean:
                                    <MudSelect T="string" @bind-Value="trigger.ExpectedValue" Label="Expected value" Required="true">
                                        <MudSelectItem T="string" Value='@("true")'>true</MudSelectItem>
                                        <MudSelectItem T="string" Value='@("false")'>false</MudSelectItem>
                                    </MudSelect>
                                    break;
                                case WorkflowTriggerValueType.Number:
                                    <MudNumericField T="double?" @bind-Value="trigger.ExpectedNumber" Label="Expected value" Required="true" />
                                    break;
                                default:
                                    <MudTextField @bind-Value="trigger.ExpectedValue" Label="Expected value" Required="true" />
                                    break;
                            }

                            break;
                    }

                    @if (trigger.Error is { } error)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddTrigger" StartIcon="@Icons.Material.Filled.Add" Class="my-2">Add trigger</MudButton>

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle1">Steps</MudText>
        @if (Model.Steps.Count == 0)
        {
            <MudText Color="Color.Secondary" Typo="Typo.caption">No steps. Add one.</MudText>
        }

        @foreach (var (index, step) in Model.Steps.Index())
        {
            <MudPaper @key="step" Class="pa-2 my-2" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Style="font-size: 0.875rem;">@(index + 1)</MudAvatar>
                        <MudSelect T="StepKind" Value="@step.Kind" ValueChanged="step.SetKind" Label="Step" Class="action-field">
                            @foreach (var kind in Enum.GetValues<StepKind>())
                            {
                                <MudSelectItem T="StepKind" Value="@kind">@kind</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSpacer />
                        <MudTooltip Text="Move up">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" aria-label="Move step up" Disabled="@(index == 0)" OnClick="() => Move(Model.Steps, step, -1)" />
                        </MudTooltip>
                        <MudTooltip Text="Move down">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" aria-label="Move step down" Disabled="@(index == Model.Steps.Count - 1)" OnClick="() => Move(Model.Steps, step, 1)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete step" Color="Color.Error" OnClick='() => RemoveAsync(Model.Steps, step, "step")' />
                        </MudTooltip>
                    </MudStack>

                    @switch (step.Kind)
                    {
                        case StepKind.DeviceAction:
                            <MudSelect T="int?" Value="@step.DeviceId" ValueChanged="value => OnStepDeviceChanged(step, value)" Label="Device" Required="true" ToStringFunc="DeviceName">
                                @foreach (var device in Devices)
                                {
                                    <MudSelectItem T="int?" Value="@device.Id">@device.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="int?" @bind-Value="step.ActionId" Label="Action" Required="true" Disabled="@(step.DeviceId is null)" ToStringFunc="ActionName">
                                @foreach (var action in ActionsOf(step.DeviceId))
                                {
                                    <MudSelectItem T="int?" Value="@action.Id">@action.Name</MudSelectItem>
                                }
                            </MudSelect>
                            break;
                        case StepKind.Delay:
                            <MudNumericField T="int?" @bind-Value="step.DelaySeconds" Label="Delay (seconds)" Required="true" Min="1" />
                            break;
                        case StepKind.Notify:
                            <MudTextField @bind-Value="step.Title" Label="Title" Required="true" />
                            <MudTextField @bind-Value="step.MessageTemplate" Label="Message" Lines="3" Required="true" HelperText="Use placeholders like {Trigger.Device}, {Trigger.Expected}, {Trigger.Current}, {Trigger.Result.snapshotUrl}, {LastStep.Message}." />
                            break;
                    }

                    @if (step.Error is { } error)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@error</MudText>
                    }
                </MudStack>
            </MudPaper>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddStep" StartIcon="@Icons.Material.Filled.Add" Class="my-2">Add step</MudButton>

        @if (!string.IsNullOrEmpty(_saveError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">@_saveError</MudAlert>
        }

        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        </MudStack>
    </MudForm>
</MudPaper>
