@page "/devices"
@using HomeManagement.Infrastructure.Database.Entities
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

<div class="devices">
    <MudTable T="Device" Items="_devices" Loading="@(_devices is null)" Dense="true" Hover="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Devices</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="ReloadAsync">Refresh</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Class="device-expand-cell"></MudTh>
            <MudTh><MudTableSortLabel T="Device" SortBy="x => x.Name" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
            <MudTh Style="white-space: nowrap"><MudTableSortLabel T="Device" SortBy="x => x.DeviceId">Device Id</MudTableSortLabel></MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var overview = deviceService.GetOverview(context);
                var presence = overview.Presence;
                var isExpanded = _expandedDevices.Contains(context.Id);
            }
            <MudTd DataLabel="Details" Class="device-expand-cell">
                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small"
                               aria-label="@(isExpanded ? $"Hide {context.Name} details" : $"Show {context.Name} details")"
                               aria-expanded="@(isExpanded ? "true" : "false")"
                               OnClick="() => ToggleDetails(context)" />
            </MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Device Id">@context.DeviceId</MudTd>
            <MudTd DataLabel="Status">
                <div class="device-status">
                    <MudTooltip Text="@GetStatusTooltip(presence)">
                        <MudChip T="string" Color="@GetStatusColor(presence)" Variant="Variant.Filled" Class="ma-0">@presence.Status.DisplayName</MudChip>
                    </MudTooltip>
                    @if (presence.LastSeenUtc is { } lastSeen)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary device-last-seen">Seen @DisplayFormatter.FormatAgo(lastSeen, Now)</MudText>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Actions">
                <div class="device-actions-container">
                    @foreach (var action in context.Actions)
                    {
                        var isRunning = _runningActions.Contains(action.Id);
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!presence.IsOnline || isRunning)" OnClick="@(() => RunActionAsync(context, action))" Class="device-action-button">
                            @if (isRunning)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                            }
                            @action.Action
                        </MudButton>
                    }
                </div>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit device" OnClick="() => EditAsync(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete device" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedDevices.Contains(context.Id))
            {
                var overview = deviceService.GetOverview(context);
                <MudTr>
                    <td colspan="6" class="mud-table-cell device-details-cell">
                        @if (overview.Info is null)
                        {
                            <div class="device-details-empty">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Name has not reported device info yet.</MudText>
                            </div>
                        }
                        else
                        {
                            <dl class="device-details">
                                <div>
                                    <dt>Address</dt>
                                    <dd>@(string.IsNullOrEmpty(overview.Info.Address) ? "-" : overview.Info.Address)</dd>
                                </div>
                                @foreach (var metric in overview.Metrics)
                                {
                                    <div>
                                        <dt>@metric.Label</dt>
                                        <dd>@metric.DisplayValue</dd>
                                    </div>
                                }
                                <div>
                                    <dt>Heartbeat</dt>
                                    <dd>Every @DisplayFormatter.FormatDuration(overview.Presence.HeartbeatInterval)</dd>
                                </div>
                                @if (overview.InfoReceivedAtUtc is { } infoReceived)
                                {
                                    <div>
                                        <dt>Info updated</dt>
                                        <dd title="@infoReceived.ToLocalTime().ToString("G")">@DisplayFormatter.FormatAgo(infoReceived, Now)</dd>
                                    </div>
                                }
                            </dl>
                        }
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText>No devices yet. Devices appear here when they connect to the MQTT broker.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</div>
