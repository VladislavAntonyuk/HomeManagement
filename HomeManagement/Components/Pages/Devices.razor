@page "/devices"
@using HomeManagement.Infrastructure.Database.Entities
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

<MudTable @ref="_table" ServerData="ServerReload" Dense="true" Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Devices</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="_table.ReloadServerData">Refresh</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Device" SortLabel="@nameof(Device.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh Style="white-space: nowrap"><MudTableSortLabel T="Device" SortLabel="@nameof(Device.DeviceId)">Device Id</MudTableSortLabel></MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        @{
            var isOnline = IsOnline(context);
        }
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Device Id">@context.DeviceId</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@(isOnline switch { true => Color.Success, false => Color.Error, null => Color.Default })" Variant="Variant.Filled">@(isOnline switch { true => "Online", false => "Offline", null => "Unknown" })</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            <div class="device-actions-container">
                @foreach (var action in context.Actions)
                {
                    var disabled = isOnline != true || _runningActions.Contains((context.Name, action));
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@disabled" OnClick="@(() => RunAction(context, action))" Class="device-action-button">
                        @if (_runningActions.Contains((context.Name, action)))
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                        }
                        @action.Action
                    </MudButton>
                }
            </div>
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit device" OnClick="() => Edit(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete device" Color="Color.Error" OnClick="() => Delete(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No devices yet. Devices appear here when they connect to the MQTT broker.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
