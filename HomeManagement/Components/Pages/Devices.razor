@page "/devices"
@using HomeManagement.Infrastructure.Database.Entities
@using HomeManagement.Shared
@attribute [Authorize]

<PageTitle>Devices</PageTitle>

<div class="devices">
    <MudTable @ref="_table" ServerData="ServerReload" Dense="true" Hover="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Devices</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="_table.ReloadServerData">Refresh</MudButton>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Class="device-expand-cell"></MudTh>
            <MudTh><MudTableSortLabel T="Device" SortLabel="@nameof(Device.Name)">Name</MudTableSortLabel></MudTh>
            <MudTh Style="white-space: nowrap"><MudTableSortLabel T="Device" SortLabel="@nameof(Device.DeviceId)">Device Id</MudTableSortLabel></MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var presence = deviceStateStore.GetPresence(context.DeviceId);
                var isOnline = presence?.IsOnline;
                var isExpanded = _expandedDevices.Contains(context.DeviceId);
            }
            <MudTd DataLabel="Details" Class="device-expand-cell">
                <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small"
                               aria-label="@(isExpanded ? $"Hide {context.Name} details" : $"Show {context.Name} details")"
                               aria-expanded="@(isExpanded ? "true" : "false")"
                               OnClick="() => ToggleDetails(context)" />
            </MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Device Id">@context.DeviceId</MudTd>
            <MudTd DataLabel="Status">
                <div class="device-status">
                    <MudTooltip Text="@GetStatusTooltip(presence)">
                        <MudChip T="string" Color="@GetStatusColor(presence)" Variant="Variant.Filled" Class="ma-0">@DeviceInfoFormatter.FormatStatus(presence)</MudChip>
                    </MudTooltip>
                    @if (presence?.LastSeenUtc is { } lastSeen)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary device-last-seen">Seen @DeviceInfoFormatter.FormatAgo(lastSeen, Now)</MudText>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Actions">
                <div class="device-actions-container">
                    @foreach (var action in context.Actions)
                    {
                        var disabled = isOnline != true || _runningActions.Contains((context.Name, action));
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="@disabled" OnClick="@(() => RunAction(context, action))" Class="device-action-button">
                            @if (_runningActions.Contains((context.Name, action)))
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                            }
                            @action.Action
                        </MudButton>
                    }
                </div>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit device" OnClick="() => Edit(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete device" Color="Color.Error" OnClick="() => Delete(context)" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedDevices.Contains(context.DeviceId))
            {
                var presence = deviceStateStore.GetPresence(context.DeviceId);
                var info = deviceStateStore.GetInfo(context.DeviceId);
                var infoTelemetry = deviceStateStore.GetTelemetry(context.DeviceId, DeviceTopics.InfoKey);
                <MudTr>
                    <td colspan="6" class="mud-table-cell device-details-cell">
                        @if (info is null)
                        {
                            <div class="device-details-empty">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Name has not reported device info yet.</MudText>
                            </div>
                        }
                        else
                        {
                            <dl class="device-details">
                                <div>
                                    <dt>Address</dt>
                                    <dd>@(string.IsNullOrEmpty(info.Address) ? "-" : info.Address)</dd>
                                </div>
                                @foreach (var (name, value) in info.Metrics.OrderBy(x => x.Key, StringComparer.Ordinal))
                                {
                                    var metric = DeviceInfoFormatter.FormatMetric(name, value);
                                    <div>
                                        <dt>@metric.Label</dt>
                                        <dd>@metric.Value</dd>
                                    </div>
                                }
                                @if (presence is not null)
                                {
                                    <div>
                                        <dt>Heartbeat</dt>
                                        <dd>Every @DeviceInfoFormatter.FormatDuration(presence.HeartbeatInterval)</dd>
                                    </div>
                                }
                                @if (infoTelemetry is not null)
                                {
                                    <div>
                                        <dt>Info updated</dt>
                                        <dd title="@infoTelemetry.ReceivedAtUtc.ToLocalTime().ToString("G")">@DeviceInfoFormatter.FormatAgo(infoTelemetry.ReceivedAtUtc, Now)</dd>
                                    </div>
                                }
                            </dl>
                        }
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudText>No devices yet. Devices appear here when they connect to the MQTT broker.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</div>
