@page "/devices"
@using HomeManagement.Infrastructure.Database.Entities
@attribute [Authorize]

<PageTitle>@Strings.Nav_Devices</PageTitle>

<div class="devices">
    <PageHeader Title="@Strings.Nav_Devices" Subtitle="@Summary()">
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Placeholder="@Strings.Devices_Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
        <MudTooltip Text="@Strings.Common_Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" aria-label="@Strings.Common_Refresh" OnClick="ReloadAsync" />
        </MudTooltip>
    </PageHeader>

    @if (_devices is null)
    {
        <div class="devices-grid">
            @for (var i = 0; i < 3; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" Class="device-skeleton" />
            }
        </div>
    }
    else if (_devices.Count == 0)
    {
        <div class="devices-empty">
            <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.body1">@Strings.Devices_Empty</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Devices_EmptyHint</MudText>
        </div>
    }
    else if (FilteredDevices().ToList() is { Count: 0 })
    {
        <div class="devices-empty">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(Strings.Devices_NoMatch, _search)</MudText>
        </div>
    }
    else
    {
        <div class="devices-grid">
            @foreach (var device in FilteredDevices())
            {
                var overview = deviceService.GetOverview(device);
                var presence = overview.Presence;
                var isExpanded = _expandedDevices.Contains(device.Id);
                var showAllActions = _expandedActions.Contains(device.Id);
                var orderedActions = OrderActions(device.Actions);
                var visibleActions = showAllActions ? orderedActions : orderedActions.Take(CollapsedActionCount);
                <section @key="device.Id" class="device-card" style="--device-status-color: @GetStatusCssColor(presence)">
                    <div class="device-card-header">
                        <span class="device-badge"><MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" /></span>
                        <div class="device-card-title">
                            <MudText Typo="Typo.subtitle1" Class="device-name">@device.Name</MudText>
                            <MudText Typo="Typo.caption" Class="device-id mud-text-secondary">@device.DeviceId</MudText>
                        </div>
                        <CardMenu Label="@string.Format(Strings.Common_Options, device.Name)" OnEdit="() => EditAsync(device)" OnDelete="() => DeleteAsync(device)" />
                    </div>

                    <div class="device-status">
                        <MudTooltip Text="@GetStatusTooltip(presence)">
                            <span class="device-status-pill">
                                <span class="device-status-dot"></span>
                                @presence.Status.DisplayName
                            </span>
                        </MudTooltip>
                        @if (presence.LastSeenUtc is { } lastSeen)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(Strings.Devices_Seen, DisplayFormatter.FormatAgo(lastSeen, Now))</MudText>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(device.Description))
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary device-description">@device.Description</MudText>
                    }

                    @if (device.Actions.Count > 0)
                    {
                        <div class="device-actions">
                            @foreach (var action in visibleActions)
                            {
                                var isRunning = _runningActions.Contains(action.Id);
                                <MudButton @key="action.Id" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           Disabled="@(!presence.IsOnline || isRunning)" OnClick="@(() => RunActionAsync(device, action))"
                                           Class="device-action">
                                    @if (isRunning)
                                    {
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="device-action-spinner" />
                                    }
                                    @DisplayFormatter.FormatActionName(action.Action)
                                </MudButton>
                            }
                            @if (device.Actions.Count > CollapsedActionCount)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="device-action"
                                           EndIcon="@(showAllActions ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           aria-expanded="@(showAllActions ? "true" : "false")"
                                           OnClick="() => Toggle(_expandedActions, device)">
                                    @(showAllActions ? Strings.Devices_ShowLess : string.Format(Strings.Devices_More, device.Actions.Count - CollapsedActionCount))
                                </MudButton>
                            }
                        </div>
                    }

                    <div class="device-card-footer">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Info"
                                   EndIcon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   aria-expanded="@(isExpanded ? "true" : "false")"
                                   OnClick="() => Toggle(_expandedDevices, device)">
                            @Strings.Devices_Details
                        </MudButton>
                    </div>

                    @if (isExpanded)
                    {
                        @if (overview.Info is null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(Strings.Devices_NoInfo, device.Name)</MudText>
                        }
                        else
                        {
                            <dl class="device-details">
                                @if (!string.IsNullOrEmpty(overview.Info.Address))
                                {
                                    <div>
                                        <dt>@Strings.Devices_Address</dt>
                                        <dd>@overview.Info.Address</dd>
                                    </div>
                                }
                                @foreach (var metric in overview.Metrics)
                                {
                                    <div>
                                        <dt>@metric.Label</dt>
                                        <dd>@metric.DisplayValue</dd>
                                    </div>
                                }
                                <div>
                                    <dt>@Strings.Devices_Heartbeat</dt>
                                    <dd>@string.Format(Strings.Devices_Every, DisplayFormatter.FormatDuration(presence.HeartbeatInterval))</dd>
                                </div>
                                @if (overview.InfoReceivedAtUtc is { } infoReceived)
                                {
                                    <div>
                                        <dt>@Strings.Devices_InfoUpdated</dt>
                                        <dd title="@infoReceived.ToLocalTime().ToString("G")">@DisplayFormatter.FormatAgo(infoReceived, Now)</dd>
                                    </div>
                                }
                            </dl>
                        }
                    }
                </section>
            }
        </div>
    }
</div>
