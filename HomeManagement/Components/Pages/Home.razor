@page "/"
@attribute [Authorize]

<PageTitle>@Strings.Nav_Home</PageTitle>

<div class="dashboard">
    <header class="dashboard-header">
        <div class="dashboard-title">
            <MudText Typo="Typo.h4" Class="dashboard-host">@_hostName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_osDescription</MudText>
        </div>
        <div class="dashboard-live" title="@string.Format(Strings.Home_RefreshesEvery, RefreshInterval.TotalSeconds)">
            <span class="dashboard-live-dot @(_updatedAt is null ? "dashboard-live-dot-waiting" : null)"></span>
            <MudText Typo="Typo.caption">@(_updatedAt is { } updatedAt ? string.Format(Strings.Home_LiveUpdated, updatedAt.ToString("HH:mm:ss")) : Strings.Home_Connecting)</MudText>
        </div>
    </header>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="3">
            <StatTile Label="@Strings.Nav_Devices" Icon="@Icons.Material.Filled.Devices" Accent="Color.Primary" Value="@(_devices is { } devices ? string.Format(Strings.Home_DevicesOnline, devices.Online, devices.Total) : null)">
                <Caption>
                    @if (_devices is { } summary)
                    {
                        <span>@string.Format(Strings.Home_DevicesCaption, summary.Offline, summary.NotResponding)</span>
                        <MudLink Href="/devices" Typo="Typo.caption">@Strings.Home_Manage</MudLink>
                    }
                </Caption>
            </StatTile>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatTile Label="@Strings.Home_Uptime" Icon="@Icons.Material.Filled.Timer" Accent="Color.Success" Value="@_uptime">
                <Caption>@string.Format(Strings.Home_Since, _bootedAt.ToString(Strings.Home_SinceFormat))</Caption>
            </StatTile>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatTile Label="@Strings.Home_LocalIp" Icon="@Icons.Material.Filled.Lan" Accent="Color.Info" Value="@(_localIp ?? Strings.Home_NoNetwork)">
                <Caption>@(LocalLink() is { } link ? $"{NetworkKindName(link.Kind)} · {link.Name}" : Strings.Home_HubAddress)</Caption>
            </StatTile>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatTile Label="@Strings.Home_HottestSensor" Icon="@Icons.Material.Filled.Thermostat" Accent="@TemperatureColor(_hottest?.Celsius)" Value="@(_hottest is { } hottest ? DisplayFormatter.FormatTemperature(hottest.Celsius) : Strings.Common_NotReported)">
                <Caption>@(_hottest is { } hottest ? SensorName(hottest.Sensor) : null)</Caption>
            </StatTile>
        </MudItem>

        <MudItem xs="12">
            <DeviceWidgets />
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <DashboardCard Title="@Strings.Home_Processor" Icon="@Icons.Material.Filled.Memory" Accent="Color.Primary">
                <Actions>
                    @if (_cpuUsage is { } headline)
                    {
                        <MudText Typo="Typo.h6" Class="dashboard-headline">@headline.ToString("0")%</MudText>
                    }
                </Actions>
                <ChildContent>
                    @if (!_metricsLoaded)
                    {
                        <MudSkeleton Height="56px" />
                    }
                    else
                    {
                        @if (_cpuUsage is { } usage)
                        {
                            <UsageMeter Label="@Strings.Home_Usage" Percent="usage" />
                        }
                        @if (_loadAverage.Count == 3)
                        {
                            <div class="dashboard-facts">
                                <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Load1</MudText><MudText Typo="Typo.body1">@_loadAverage[0].ToString("0.00")</MudText></div>
                                <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Load5</MudText><MudText Typo="Typo.body1">@_loadAverage[1].ToString("0.00")</MudText></div>
                                <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Load15</MudText><MudText Typo="Typo.body1">@_loadAverage[2].ToString("0.00")</MudText></div>
                            </div>
                        }
                        @if (_cpuModel is { } model)
                        {
                            <div class="dashboard-footnote">
                                <MudText Typo="Typo.body2">@FormatCpuModel(model)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(Strings.Home_Threads, model.Architecture, model.LogicalCpus)</MudText>
                            </div>
                        }
                    }
                </ChildContent>
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" md="6" lg="4">
            <DashboardCard Title="@Strings.Home_Memory" Icon="@Icons.Material.Filled.ViewModule" Accent="Color.Secondary">
                <Actions>
                    @if (_memory is { } headline)
                    {
                        <MudText Typo="Typo.h6" Class="dashboard-headline">@headline.UsedPercent.ToString("0")%</MudText>
                    }
                </Actions>
                <ChildContent>
                    @if (!_metricsLoaded)
                    {
                        <MudSkeleton Height="56px" />
                    }
                    else if (_memory is not { } memory)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Common_NotReported</MudText>
                    }
                    else
                    {
                        <UsageMeter Label="@Strings.Home_Ram" Percent="memory.UsedPercent" Detail="@string.Format(Strings.Home_UsedOf, FormatSize(memory.UsedBytes), FormatSize(memory.TotalBytes))" />
                        @if (memory.SwapTotalBytes > 0)
                        {
                            <UsageMeter Label="@Strings.Home_Swap" Percent="memory.SwapUsedPercent" Detail="@string.Format(Strings.Home_UsedOf, FormatSize(memory.SwapUsedBytes), FormatSize(memory.SwapTotalBytes))" />
                        }
                        <div class="dashboard-facts dashboard-footnote">
                            <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Available</MudText><MudText Typo="Typo.body1">@FormatSize(memory.AvailableBytes)</MudText></div>
                            <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Cache</MudText><MudText Typo="Typo.body1">@FormatSize(memory.CacheBytes)</MudText></div>
                            <div><MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Home_Total</MudText><MudText Typo="Typo.body1">@FormatSize(memory.TotalBytes)</MudText></div>
                        </div>
                    }
                </ChildContent>
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" md="12" lg="4">
            <DashboardCard Title="@Strings.Home_Temperatures" Icon="@Icons.Material.Filled.DeviceThermostat" Accent="@TemperatureColor(_hottest?.Celsius)">
                @if (_temperatures.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Home_NoSensors</MudText>
                }
                else
                {
                    <div class="dashboard-sensors">
                        @foreach (var sensor in _temperatures)
                        {
                            <div @key="sensor.Sensor" class="dashboard-sensor">
                                <div class="dashboard-sensor-header">
                                    <MudText Typo="Typo.body2" title="@sensor.Sensor">@SensorName(sensor.Sensor)</MudText>
                                    <MudText Typo="Typo.body2" Color="@TemperatureColor(sensor.Celsius)"><b>@DisplayFormatter.FormatTemperature(sensor.Celsius)</b></MudText>
                                </div>
                                <MudProgressLinear Value="@Math.Clamp(sensor.Celsius, 0, 100)" Color="@TemperatureColor(sensor.Celsius)" Rounded="true" Size="Size.Small" />
                            </div>
                        }
                    </div>
                }
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" lg="6">
            <DashboardCard Title="@Strings.Home_Storage" Icon="@Icons.Material.Filled.Storage" Accent="Color.Warning">
                @if (_disks is null)
                {
                    <MudSkeleton Height="56px" />
                }
                else if (_disks.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Common_NotReported</MudText>
                }
                else
                {
                    <div class="dashboard-tiles">
                        @foreach (var disk in _disks)
                        {
                            <UsageMeter @key="disk.MountPoint" Label="@disk.MountPoint" Percent="disk.UsedPercent" Detail="@string.Format(Strings.Home_FreeOf, FormatSize(disk.AvailableBytes), FormatSize(disk.TotalBytes), disk.FileSystem)" />
                        }
                    </div>
                }
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" lg="6">
            <DashboardCard Title="@Strings.Home_Network" Icon="@Icons.Material.Filled.Hub" Accent="Color.Info">
                @if (_network is null)
                {
                    <MudSkeleton Height="56px" />
                }
                else if (_network.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Common_NotReported</MudText>
                }
                else
                {
                    <div class="dashboard-tiles">
                        @foreach (var link in _network)
                        {
                            <div @key="link.Name" class="network-link @(link.IsUp ? null : "network-link-down")">
                                <MudIcon Icon="@NetworkIcon(link.Kind)" Color="@(link.IsUp ? Color.Success : Color.Default)" Size="Size.Small" />
                                <div class="network-link-details">
                                    <MudText Typo="Typo.body2">
                                        <b>@NetworkKindName(link.Kind)</b>
                                        <span class="mud-text-secondary">@link.Name@(link.SpeedMbps is { } speed ? string.Format(Strings.Home_LinkSpeed, speed) : null)@(link.IsUp ? null : Strings.Home_LinkDown)</span>
                                    </MudText>
                                    @foreach (var address in link.Addresses)
                                    {
                                        <MudText Typo="Typo.caption" Class="network-address">@address</MudText>
                                    }
                                    @if (link.IsUp)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">↓ @FormatSize(link.ReceivedBytes) · ↑ @FormatSize(link.SentBytes)</MudText>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" lg="4">
            <DashboardCard Title="@Strings.Home_Controls" Icon="@Icons.Material.Filled.Tune" Accent="Color.Tertiary">
                <div class="dashboard-controls">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">@Strings.Home_Router</MudText>
                    <MudButton OnClick="RebootRouter" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Router" FullWidth="true">@Strings.Home_RebootRouter</MudButton>
                    <MudButton OnClick="RebootRouterModem" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MobiledataOff" FullWidth="true">@Strings.Home_RebootModem</MudButton>
                    <MudButton OnClick="TurnOffRouterLeds" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lightbulb" FullWidth="true">@Strings.Home_TurnOffLeds</MudButton>
                </div>
                <div class="dashboard-controls">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">@Strings.Home_Server</MudText>
                    <MudButton OnClick="Reboot" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" FullWidth="true">@Strings.Home_Reboot</MudButton>
                    <MudButton OnClick="Shutdown" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PowerSettingsNew" FullWidth="true">@Strings.Home_ShutDown</MudButton>
                </div>
            </DashboardCard>
        </MudItem>

        <MudItem xs="12" lg="8">
            <DashboardCard Title="@Strings.Home_Terminal" Icon="@Icons.Material.Filled.Terminal" Accent="Color.Success">
                <div class="terminal">
                    <pre class="terminal-output">@(string.IsNullOrEmpty(_terminalOutput) ? Strings.Home_TerminalHint : _terminalOutput)</pre>
                    <div class="terminal-prompt">
                        <span class="terminal-sign">$</span>
                        <input class="terminal-input" @bind="_terminalCommand" @bind:event="oninput" @onkeydown="OnTerminalKeyDown" placeholder="@Strings.Home_EnterCommand" spellcheck="false" autocomplete="off" aria-label="@Strings.Home_Command" />
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small" OnClick="RunTerminalCommand" Disabled="@(_terminalRunning || string.IsNullOrWhiteSpace(_terminalCommand))" aria-label="@Strings.Common_Run" />
                    </div>
                </div>
            </DashboardCard>
        </MudItem>
    </MudGrid>
</div>
