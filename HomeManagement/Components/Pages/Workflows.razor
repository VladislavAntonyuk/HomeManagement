@page "/workflows"
@using HomeManagement.Application.Workflows
@using Workflow = HomeManagement.Infrastructure.Database.Entities.Workflow
@attribute [Authorize]

<PageTitle>Workflows</PageTitle>

<MudTable T="Workflow" Items="_workflows" Loading="@(_workflows is null)" Dense="true" Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Workflows</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="ReloadAsync">Refresh</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="AddAsync">Add</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Workflow" SortBy="x => x.Name" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Workflow" SortBy="x => x.ConditionOperator">Logic</MudTableSortLabel></MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh>Triggers</MudTh>
        <MudTh>Steps</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1">@context.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(context.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Logic">
            @if (context.Triggers.Count == 0)
            {
                <MudText Typo="Typo.body2">Manual</MudText>
            }
            else
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">@context.ConditionOperator</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RepeatWhileMatched ? "Repeats while matched" : "Once per match")</MudText>
                </MudStack>
            }
        </MudTd>
        <MudTd DataLabel="Enabled">
            <MudChip T="string" Color="@(context.IsEnabled ? Color.Success : Color.Default)" Variant="Variant.Filled">@(context.IsEnabled ? "Yes" : "No")</MudChip>
        </MudTd>
        <MudTd DataLabel="Triggers">@WorkflowFormatter.FormatTrigger(context)</MudTd>
        <MudTd DataLabel="Steps">@context.Steps.Count</MudTd>
        <MudTd>
            <MudButton Size="Size.Small"
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="@_runningWorkflows.Contains(context.Id)"
                OnClick="() => RunAsync(context)">
                @if (_runningWorkflows.Contains(context.Id))
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                }
                Run
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit workflow" OnClick="() => EditAsync(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete workflow" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No workflows yet</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>
