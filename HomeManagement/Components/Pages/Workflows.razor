@page "/workflows"
@using HomeManagement.Application.Workflows
@using HomeManagement.Infrastructure.Database.Entities
@using Workflow = HomeManagement.Infrastructure.Database.Entities.Workflow
@attribute [Authorize]

<PageTitle>@Strings.Nav_Workflows</PageTitle>

<div class="workflows">
    <PageHeader Title="@Strings.Nav_Workflows" Subtitle="@Summary()">
        <MudTextField T="string" @bind-Value="_search" Immediate="true" Placeholder="@Strings.Workflows_Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
        <MudTooltip Text="@Strings.Common_Refresh">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" aria-label="@Strings.Common_Refresh" OnClick="ReloadAsync" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@Strings.Common_Add</MudButton>
    </PageHeader>

    @if (_workflows is null)
    {
        <div class="workflows-grid">
            @for (var i = 0; i < 3; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" Class="workflow-skeleton" />
            }
        </div>
    }
    else if (_workflows.Count == 0)
    {
        <div class="workflows-empty">
            <MudIcon Icon="@WorkflowIcons.Workflow" Size="Size.Large" Class="mud-text-secondary" />
            <MudText Typo="Typo.body1">@Strings.Workflows_Empty</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Workflows_EmptyHint</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@Strings.Workflows_AddWorkflow</MudButton>
        </div>
    }
    else if (FilteredWorkflows().ToList() is { Count: 0 })
    {
        <div class="workflows-empty">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(Strings.Workflows_NoMatch, _search)</MudText>
        </div>
    }
    else
    {
        <div class="workflows-grid">
            @foreach (var workflow in FilteredWorkflows())
            {
                var isRunning = _runningWorkflows.Contains(workflow.Id);
                <section @key="workflow.Id" class="workflow-card @(workflow.IsEnabled ? null : "workflow-card-disabled")">
                    <div class="workflow-card-header">
                        <span class="workflow-badge"><MudIcon Icon="@WorkflowIcons.Workflow" Size="Size.Small" /></span>
                        <div class="workflow-card-title">
                            <MudText Typo="Typo.subtitle1" Class="workflow-name">@workflow.Name</MudText>
                            @if (!string.IsNullOrWhiteSpace(workflow.Description))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary workflow-description">@workflow.Description</MudText>
                            }
                        </div>
                        <MudTooltip Text="@(workflow.IsEnabled ? Strings.Workflows_EnabledTooltip : Strings.Workflows_DisabledTooltip)">
                            <MudSwitch T="bool" Value="workflow.IsEnabled" ValueChanged="enabled => SetEnabledAsync(workflow, enabled)"
                                       Color="Color.Success" Class="workflow-switch" aria-label="@string.Format(Strings.Workflows_EnableAria, workflow.Name)" />
                        </MudTooltip>
                        <CardMenu Label="@string.Format(Strings.Common_Options, workflow.Name)" OnEdit="() => EditAsync(workflow)" OnDelete="() => DeleteAsync(workflow)" />
                    </div>

                    <div class="workflow-section">
                        <div class="workflow-section-label">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">@Strings.Workflows_When</MudText>
                            @if (workflow.Triggers.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">· @(workflow.RepeatWhileMatched ? Strings.Workflows_RepeatsWhileMatched : Strings.Workflows_OncePerMatch)</MudText>
                            }
                        </div>
                        @if (workflow.Triggers.Count == 0)
                        {
                            <div class="workflow-trigger">
                                <MudIcon Icon="@WorkflowIcons.Manual" Size="Size.Small" />
                                <span>@WorkflowFormatter.ManualTrigger</span>
                            </div>
                        }
                        else
                        {
                            <div class="workflow-triggers">
                                @for (var i = 0; i < workflow.Triggers.Count; i++)
                                {
                                    var trigger = workflow.Triggers[i];
                                    @if (i > 0)
                                    {
                                        <span class="workflow-operator">@WorkflowFormatter.FormatConditionOperator(workflow.ConditionOperator)</span>
                                    }
                                    <div class="workflow-trigger">
                                        <MudIcon Icon="@TriggerIcon(trigger)" Size="Size.Small" />
                                        <span>@WorkflowFormatter.Format(trigger)</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="workflow-section">
                        <div class="workflow-section-label">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">@Strings.Workflows_Then</MudText>
                        </div>
                        @if (workflow.Steps.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Strings.Workflows_NoSteps</MudText>
                        }
                        else
                        {
                            <ol class="workflow-steps">
                                @foreach (var step in workflow.Steps)
                                {
                                    <li @key="step.Id" class="workflow-step">
                                        <MudIcon Icon="@StepIcon(step)" Size="Size.Small" />
                                        <span>@FormatStep(step)</span>
                                    </li>
                                }
                            </ol>
                        }
                    </div>

                    <div class="workflow-card-footer">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" title="@workflow.LastTriggeredAtUtc?.ToLocalTime().ToString("G")">
                            @string.Format(Strings.Workflows_LastRun, DisplayFormatter.FormatAgo(workflow.LastTriggeredAtUtc, Now))
                        </MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="isRunning"
                                   StartIcon="@(isRunning ? null : Icons.Material.Filled.PlayArrow)" Class="workflow-run"
                                   OnClick="() => RunAsync(workflow)">
                            @if (isRunning)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="workflow-run-spinner" />
                            }
                            @Strings.Common_Run
                        </MudButton>
                    </div>
                </section>
            }
        </div>
    }
</div>
