@page "/workflows"
@using HomeManagement.Shared
@using Workflow = HomeManagement.Infrastructure.Database.Entities.Workflow
@attribute [Authorize]

<PageTitle>Workflows</PageTitle>

<MudTable @ref="_table" ServerData="ServerReload" Dense="true" Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Workflows</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="_table.ReloadServerData">Refresh</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="me-2 mb-1" OnClick="Add">Add</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Workflow" SortLabel="@nameof(Workflow.Name)">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Workflow" SortLabel="@nameof(Workflow.ConditionOperator)">Logic</MudTableSortLabel></MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh>Condition / Schedule</MudTh>
        <MudTh>Steps</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body1">@context.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(context.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Logic">
            <MudStack Spacing="0">
                <MudText Typo="Typo.body2">@context.ConditionOperator</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(context.RepeatWhileMatched ? "Repeats while matched" : "Once per match")</MudText>
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Enabled">
            <MudChip T="string" Color="@(context.IsEnabled ? Color.Success : Color.Default)" Variant="Variant.Filled">@(context.IsEnabled ? "Yes" : "No")</MudChip>
        </MudTd>
        <MudTd DataLabel="Condition / Schedule">@GetTriggerSummary(context)</MudTd>
        <MudTd DataLabel="Steps">@context.Steps.Count</MudTd>
        <MudTd>
            <MudButton Size="Size.Small"
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="@_runningWorkflows.Contains(context.Name)"
                OnClick="() => Run(context)">
                @if (_runningWorkflows.Contains(context.Name))
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-1" />
                }
                Run
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => Edit(context)" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Delete(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No workflows found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>