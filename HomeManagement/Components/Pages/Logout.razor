@page "/Account/Logout"

<PageTitle>Log out</PageTitle>

<AuthCard Title="Log out?" Subtitle="You will need your key to sign in again.">
    <form method="post" action="api/account/logout" class="logout-form">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   FullWidth="true" StartIcon="@Icons.Material.Rounded.Logout">Log out</MudButton>
        <MudButton Href="/" Variant="Variant.Text" FullWidth="true">Cancel</MudButton>
    </form>
</AuthCard>
