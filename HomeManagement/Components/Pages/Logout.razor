@page "/Account/Logout"

<PageTitle>@Strings.Nav_LogOut</PageTitle>

<AuthCard Title="@Strings.Logout_Title" Subtitle="@Strings.Logout_Subtitle">
    <form method="post" action="api/account/logout" class="logout-form">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   FullWidth="true" StartIcon="@Icons.Material.Rounded.Logout">@Strings.Nav_LogOut</MudButton>
        <MudButton Href="/" Variant="Variant.Text" FullWidth="true">@Strings.Common_Cancel</MudButton>
    </form>
</AuthCard>
