<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<PublishAot>false</PublishAot>
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
		<PackageReference Include="Silverback.Integration.MQTT" Version="5.10.0" />
		<ProjectReference Include="..\..\HomeManagement.DeviceSdk\HomeManagement.DeviceSdk.csproj" />
		<ProjectReference Include="..\..\HomeManagement.ServiceDefaults\HomeManagement.ServiceDefaults.csproj" />
		<!-- appsettings.Development.json holds the Tuya keys; deploy.ps1 publishes it as appsettings.json. -->
		<Content Update="appsettings.*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<!-- deploy.ps1 runs it on the hub machine to install the systemd service. -->
		<None Update="install.sh" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
