{
  "Logging": {
	"LogLevel": {
	  "Default": "Information"
	}
  },
  "DeviceName": "LiveCamera",
  "ConnectionStrings": {
	"mqtt": "mqtt://192.168.50.151:1883"
  },
  "CommandsSettings": {
	"Commands": [
	  {
		"Name": "Start LiveCamera",
		"Endpoint": "live-camera/start",
		"Method": "Post",
		"FileName": "sudo",
		"Arguments": [
		  "systemctl start live-camera"
		]
	  },
	  {
		"Name": "Stop LiveCamera",
		"Endpoint": "live-camera/stop",
		"Method": "Post",
		"FileName": "sudo",
		"Arguments": [
		  "systemctl stop live-camera"
		]
	  },
	  {
		"Name": "Get Motion",
		"Endpoint": "motion",
		"Method": "Get",
		"FileName": "sudo",
		"Arguments": [
		  "/home/orangepi/Projects/MotionDetector/get-motion.sh"
		]
	  }
	]
  }
}